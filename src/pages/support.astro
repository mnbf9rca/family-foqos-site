---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Support - Family Foqos">
  <main class="py-24">
    <div class="container max-w-3xl">
      <div class="animate-fade-in-up">
        <a href="/" class="inline-flex items-center gap-2 text-text-secondary hover:text-text transition-colors mb-8">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to Home
        </a>

        <h1 class="heading-lg mb-8">Support</h1>

        <div class="space-y-12 text-text-secondary">

          <!-- NFC Tags Section -->
          <section class="space-y-6">
            <h2 class="heading-md text-text flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-iris/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-iris" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4" />
                </svg>
              </div>
              NFC Tags
            </h2>

            <p class="body-lg text-text">
              Family Foqos uses NFC (Near Field Communication) tags as physical triggers for focus sessions. Here's everything you need to know about choosing and using NFC tags.
            </p>

            <div class="card p-6 space-y-4">
              <h3 class="heading-sm text-text">Compatible NFC Tags</h3>
              <p>
                Family Foqos works with <strong class="text-text">any NFC tag</strong> that your iPhone can read. The most common and recommended types are:
              </p>
              <ul class="space-y-3">
                <li class="flex items-start gap-3">
                  <span class="w-6 h-6 rounded-full bg-mint/20 text-mint flex items-center justify-center flex-shrink-0 mt-0.5 text-sm font-bold">1</span>
                  <div>
                    <strong class="text-text">NTAG213</strong> — 144 bytes storage. Perfect for simple triggers. Most affordable option.
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-6 h-6 rounded-full bg-mint/20 text-mint flex items-center justify-center flex-shrink-0 mt-0.5 text-sm font-bold">2</span>
                  <div>
                    <strong class="text-text">NTAG215</strong> — 504 bytes storage. Good balance of capacity and price.
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-6 h-6 rounded-full bg-mint/20 text-mint flex items-center justify-center flex-shrink-0 mt-0.5 text-sm font-bold">3</span>
                  <div>
                    <strong class="text-text">NTAG216</strong> — 888 bytes storage. More than you'll need, but works great.
                  </div>
                </li>
              </ul>
              <p class="text-sm text-text-muted">
                All NTAG21x series tags are ISO 14443A compliant and work with iPhone 7 and later.
              </p>
            </div>

            <div class="card p-6 space-y-4">
              <h3 class="heading-sm text-text">Where to Buy</h3>
              <p>
                NFC tags are inexpensive and widely available. You can find them on:
              </p>
              <ul class="list-disc list-inside space-y-2 ml-4">
                <li>Amazon (search "NTAG215 NFC tags")</li>
                <li>AliExpress (for bulk orders)</li>
                <li>Specialty NFC retailers like GoToTags, NFC Tagify, or Seritag</li>
              </ul>
              <p class="text-sm text-text-muted">
                Expect to pay around $0.30–$1.00 per tag depending on quantity and form factor.
              </p>
            </div>

            <div class="card p-6 space-y-4">
              <h3 class="heading-sm text-text">Form Factors</h3>
              <p>
                NFC tags come in various shapes. Choose based on where you'll place them:
              </p>
              <div class="grid sm:grid-cols-2 gap-4 mt-4">
                <div class="p-4 rounded-xl bg-elevated/50">
                  <strong class="text-text block mb-1">Stickers/Labels</strong>
                  <span class="text-sm">Stick on desks, walls, or devices. Most versatile.</span>
                </div>
                <div class="p-4 rounded-xl bg-elevated/50">
                  <strong class="text-text block mb-1">Cards</strong>
                  <span class="text-sm">Credit card size. Great for wallets or as focus "keys."</span>
                </div>
                <div class="p-4 rounded-xl bg-elevated/50">
                  <strong class="text-text block mb-1">Keychains</strong>
                  <span class="text-sm">Portable. Kids can carry their own focus trigger.</span>
                </div>
                <div class="p-4 rounded-xl bg-elevated/50">
                  <strong class="text-text block mb-1">Wristbands</strong>
                  <span class="text-sm">Wearable option. Tap your wrist to your phone.</span>
                </div>
              </div>
            </div>

            <div class="card p-6 space-y-4">
              <h3 class="heading-sm text-text">Tips for Families</h3>
              <ul class="space-y-3">
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-amber flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                  </svg>
                  <span><strong class="text-text">Color code tags</strong> — Use different colored stickers for different profiles (blue for homework, green for bedtime).</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-amber flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                  </svg>
                  <span><strong class="text-text">Strategic placement</strong> — Put tags where focus happens: study desks, dining table, bedroom doorframes.</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-amber flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                  </svg>
                  <span><strong class="text-text">Make it a ritual</strong> — The physical act of tapping creates a psychological trigger that builds habits.</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-amber flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                  </svg>
                  <span><strong class="text-text">Keep spares</strong> — Tags are cheap. Buy extra in case one gets lost or damaged.</span>
                </li>
              </ul>
            </div>

            <div class="card p-6 space-y-4 border-amber/30">
              <h3 class="heading-sm text-text">iPhone Compatibility</h3>
              <p>
                NFC tag reading requires <strong class="text-text">iPhone 7 or later</strong>. On iPhone XS/XR and later, background NFC reading is supported—just tap without opening the app first.
              </p>
              <p class="text-sm text-text-muted">
                Note: iPads do not have NFC readers. Use QR codes for iPad focus triggers instead.
              </p>
            </div>
          </section>

          <!-- QR Codes Section -->
          <section class="space-y-6">
            <h2 class="heading-md text-text flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-amber/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
                </svg>
              </div>
              QR Codes
            </h2>

            <p>
              QR codes work on both iPhones and iPads. Family Foqos can generate QR codes for any profile—print them and place them around your home as visual focus triggers.
            </p>

            <div class="card p-6 space-y-4">
              <h3 class="heading-sm text-text">QR Code Ideas</h3>
              <ul class="list-disc list-inside space-y-2 ml-4">
                <li>Print and frame a "Homework Mode" QR code for the study area</li>
                <li>Laminate a "Dinner Time" code for the kitchen</li>
                <li>Create a poster with multiple profile codes for kids to choose from</li>
                <li>Add to a family command center or chore chart</li>
              </ul>
            </div>
          </section>

          <!-- Getting Help Section -->
          <section class="space-y-6">
            <h2 class="heading-md text-text flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-rose/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-rose" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              Getting Help
            </h2>

            <p>
              Family Foqos is open source and community-supported. Here's how to get help:
            </p>

            <div class="grid sm:grid-cols-2 gap-4">
              <a
                href="https://github.com/mnbf9rca/family-foqos/discussions"
                target="_blank"
                rel="noopener noreferrer"
                class="card p-6 hover:border-iris/50 transition-colors group"
              >
                <div class="flex items-center gap-3 mb-3">
                  <svg class="w-6 h-6 text-iris" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                  <strong class="text-text">GitHub Discussions</strong>
                </div>
                <p class="text-sm">Ask questions, share ideas, and connect with other families using Foqos.</p>
              </a>

              <a
                href="https://github.com/mnbf9rca/family-foqos/issues"
                target="_blank"
                rel="noopener noreferrer"
                class="card p-6 hover:border-amber/50 transition-colors group"
              >
                <div class="flex items-center gap-3 mb-3">
                  <svg class="w-6 h-6 text-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <strong class="text-text">Report Issues</strong>
                </div>
                <p class="text-sm">Found a bug? Let us know on GitHub Issues.</p>
              </a>
            </div>
          </section>

        </div>
      </div>
    </div>
  </main>
</Layout>
