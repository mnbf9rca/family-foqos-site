---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found - Family Foqos" description="This page doesn't exist. Head back to the Family Foqos homepage." noindex>
  <section class="py-24">
    <div class="container max-w-2xl text-center">
      <h1 class="heading-lg mb-6">Page not found</h1>
      <p class="body-lg text-text-secondary mb-10">
        We couldn't find that page. It may have moved, or the link may be wrong.
      </p>
      <a href="/" class="text-text-secondary hover:text-text underline underline-offset-4">Back to homepage</a>
    </div>
  </section>
</Layout>
