---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Block Everywhere - Family Foqos" description="Sync your focus profiles across all your Apple devices. When blocking is on, it's on everywhere.">
  <main class="py-24">
    <div class="container max-w-3xl">
      <div class="animate-fade-in-up">
        <a href="/" class="inline-flex items-center gap-2 text-text-secondary hover:text-text transition-colors mb-8">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to Home
        </a>

        <!-- Hero -->
        <div class="mb-12">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-sky/10 border border-sky/30 text-sky text-sm font-medium mb-6">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z" />
            </svg>
            Device Sync
          </div>
          <h1 class="heading-lg mb-6">Block Everywhere</h1>
          <p class="body-lg text-text-secondary">
            Set up once, stay focused everywhere. When you block distractions on one device, all your devices follow. No more switching to your iPad to cheat.
          </p>
        </div>

        <div class="space-y-12 text-text-secondary">

          <!-- Personal Sync Callout -->
          <section class="card p-6 border-sky/30 bg-gradient-to-br from-sky/5 to-transparent">
            <div class="flex gap-4">
              <div class="w-10 h-10 rounded-xl bg-sky/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-sky" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <div>
                <h3 class="heading-sm text-text mb-2">This is Personal Sync</h3>
                <p>
                  Device sync is for keeping <em>your own</em> devices in harmony - like your iPhone and iPad. It uses your personal iCloud account and only syncs between devices signed into the same Apple ID.
                </p>
                <p class="mt-3 text-sm text-text-muted">
                  Looking for family features? Check out <a href="/support#safety" class="text-iris hover:text-iris-bright underline">Parent & Child modes</a> and <a href="/#features" class="text-iris hover:text-iris-bright underline">Shared Lock Codes</a> instead.
                </p>
              </div>
            </div>
          </section>

          <!-- How to Enable -->
          <section class="space-y-6">
            <h2 class="heading-md text-text flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-mint/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              How to Enable
            </h2>

            <div class="card p-6 space-y-4">
              <ol class="space-y-4">
                <li class="flex items-start gap-4">
                  <span class="w-7 h-7 rounded-full bg-sky/20 text-sky flex items-center justify-center flex-shrink-0 text-sm font-bold">1</span>
                  <div>
                    <strong class="text-text">Open Settings</strong>
                    <p class="text-sm mt-1">Tap the gear icon in Family Foqos</p>
                  </div>
                </li>
                <li class="flex items-start gap-4">
                  <span class="w-7 h-7 rounded-full bg-sky/20 text-sky flex items-center justify-center flex-shrink-0 text-sm font-bold">2</span>
                  <div>
                    <strong class="text-text">Find Device Sync</strong>
                    <p class="text-sm mt-1">Scroll to the Device Sync section</p>
                  </div>
                </li>
                <li class="flex items-start gap-4">
                  <span class="w-7 h-7 rounded-full bg-sky/20 text-sky flex items-center justify-center flex-shrink-0 text-sm font-bold">3</span>
                  <div>
                    <strong class="text-text">Toggle it on</strong>
                    <p class="text-sm mt-1">Enable sync and repeat on your other devices</p>
                  </div>
                </li>
              </ol>
            </div>
          </section>

          <!-- App Selection Explanation -->
          <section class="space-y-6">
            <h2 class="heading-md text-text flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-amber/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                </svg>
              </div>
              Why Pick Apps on Each Device?
            </h2>

            <p class="body-lg text-text">
              You'll notice that when you set up a new device, you need to select which apps to block - even if you've already picked them on another device.
            </p>

            <div class="card p-6 space-y-4 border-amber/30">
              <h3 class="heading-sm text-text">This is an Apple security requirement</h3>
              <p>
                Apple's Screen Time API requires that app blocking permissions be granted directly on each device. This is a privacy protection - it ensures no remote app or service can silently start blocking apps without your knowledge.
              </p>
              <p class="text-sm text-text-muted mt-3">
                The good news: you only need to do this once per device. After that initial selection, everything else syncs automatically.
              </p>
            </div>
          </section>

          <!-- What Syncs Table -->
          <section class="space-y-6">
            <h2 class="heading-md text-text flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-iris/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-iris" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
              </div>
              What Gets Synced
            </h2>

            <div class="card overflow-hidden">
              <div class="grid md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-elevated">
                <!-- Syncs Automatically Column -->
                <div class="p-6">
                  <div class="flex items-center gap-2 mb-4">
                    <div class="w-6 h-6 rounded-full bg-mint/20 flex items-center justify-center">
                      <svg class="w-3.5 h-3.5 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                    </div>
                    <h3 class="heading-sm text-text">Syncs Automatically</h3>
                  </div>
                  <ul class="space-y-3">
                    <li class="flex items-center gap-3">
                      <span class="w-1.5 h-1.5 rounded-full bg-mint"></span>
                      Profile names & settings
                    </li>
                    <li class="flex items-center gap-3">
                      <span class="w-1.5 h-1.5 rounded-full bg-mint"></span>
                      Schedules (days & times)
                    </li>
                    <li class="flex items-center gap-3">
                      <span class="w-1.5 h-1.5 rounded-full bg-mint"></span>
                      Saved locations
                    </li>
                    <li class="flex items-center gap-3">
                      <span class="w-1.5 h-1.5 rounded-full bg-mint"></span>
                      Whether blocking is active
                    </li>
                    <li class="flex items-center gap-3">
                      <span class="w-1.5 h-1.5 rounded-full bg-mint"></span>
                      Break settings
                    </li>
                    <li class="flex items-center gap-3">
                      <span class="w-1.5 h-1.5 rounded-full bg-mint"></span>
                      Strict mode
                    </li>
                  </ul>
                </div>

                <!-- Set Once Per Device Column -->
                <div class="p-6 bg-abyss/30">
                  <div class="flex items-center gap-2 mb-4">
                    <div class="w-6 h-6 rounded-full bg-amber/20 flex items-center justify-center">
                      <svg class="w-3.5 h-3.5 text-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                      </svg>
                    </div>
                    <h3 class="heading-sm text-text">Set Once Per Device</h3>
                  </div>
                  <ul class="space-y-3">
                    <li class="flex items-center gap-3">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber"></span>
                      Which apps to block
                    </li>
                  </ul>
                  <p class="text-sm text-text-muted mt-6">
                    Apple requires app selection to happen locally on each device for privacy.
                  </p>
                </div>
              </div>
            </div>
          </section>

          <!-- Troubleshooting -->
          <section class="space-y-6">
            <h2 class="heading-md text-text flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-rose/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-rose" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
              </div>
              Troubleshooting
            </h2>

            <div class="card p-6 space-y-4">
              <p class="text-text">
                If sync isn't working, try these steps:
              </p>
              <ul class="space-y-3">
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-iris flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span><strong class="text-text">Check iCloud status</strong> - Make sure you're signed into the same iCloud account on all devices.</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-iris flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span><strong class="text-text">Verify network connection</strong> - Sync requires an internet connection to communicate with iCloud.</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-iris flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span><strong class="text-text">Use "Sync Now"</strong> - In Settings → Device Sync, tap "Sync Now" to force an immediate sync.</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-iris flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span><strong class="text-text">Check iCloud Drive</strong> - Family Foqos uses iCloud Drive for sync. Ensure it's enabled in iOS Settings → [Your Name] → iCloud → iCloud Drive.</span>
                </li>
              </ul>
            </div>
          </section>

          <!-- Still need help -->
          <section class="pt-8 border-t border-elevated">
            <p class="text-text-muted">
              Still having trouble? <a href="/support#getting-help" class="text-iris hover:text-iris-bright underline">Check out our support resources</a> or open an issue on GitHub.
            </p>
          </section>

        </div>
      </div>
    </div>
  </main>
</Layout>
