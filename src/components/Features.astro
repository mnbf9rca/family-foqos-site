---
// Features grid - 12 family-focused features

const features = [
  {
    icon: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4" /></svg>`,
    title: "NFC Blocking",
    description: "Tap a physical NFC tag to start your focus session. A tangible ritual that makes blocking feel intentional.",
    color: "iris",
    isNew: false
  },
  {
    icon: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" /></svg>`,
    title: "QR Blocking",
    description: "Scan a QR code to instantly activate a blocking profile. Place codes around your home for quick access.",
    color: "amber",
    isNew: false
  },
  {
    icon: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>`,
    title: "Custom Profiles",
    description: "Create unlimited profiles with different blocking rules for work, study, sleep, or family time.",
    color: "mint",
    isNew: false
  },
  {
    icon: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
    title: "Timer Mode",
    description: "Set focus sessions for specific durations. The app handles the rest—no willpower required.",
    color: "sky",
    isNew: false
  },
  {
    icon: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" /></svg>`,
    title: "Website Blocking",
    description: "Block distracting websites and apps across profiles. Set it once, enforce it always.",
    color: "rose",
    isNew: false
  },
  {
    icon: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>`,
    title: "Habit Tracking",
    description: "Build focus habits with streaks and insights. Watch your family's focus time grow together.",
    color: "iris",
    isNew: false
  },
  {
    icon: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
    title: "Live Activities",
    description: "See your current focus session on the Lock Screen and Dynamic Island. Always know your status.",
    color: "amber",
    isNew: false
  },
  {
    icon: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`,
    title: "Privacy-First",
    description: "Your data stays on your devices. No accounts, no tracking, no selling your focus habits.",
    color: "mint",
    isNew: false
  },
  {
    icon: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
    title: "Open Source",
    description: "Fully open source on GitHub. Audit the code, contribute, or fork it for your own needs.",
    color: "sky",
    isNew: false
  },
  {
    icon: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
    title: "Parent Mode",
    description: "Full control over family settings. Create, edit, and lock profiles for your children.",
    color: "rose",
    isNew: true
  },
  {
    icon: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>`,
    title: "Child Mode",
    description: "Simplified interface for kids. They see their profiles, but can't change locked settings.",
    color: "iris",
    isNew: true
  },
  {
    icon: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" /></svg>`,
    title: "Shared Lock Codes",
    description: "Sync parent lock codes across your family's devices via iCloud. One code works everywhere.",
    color: "amber",
    isNew: true
  }
];

const colorClasses = {
  iris: {
    bg: "bg-iris/10",
    border: "group-hover:border-iris/50",
    icon: "text-iris",
    glow: "group-hover:shadow-iris/20"
  },
  amber: {
    bg: "bg-amber/10",
    border: "group-hover:border-amber/50",
    icon: "text-amber",
    glow: "group-hover:shadow-amber/20"
  },
  mint: {
    bg: "bg-mint/10",
    border: "group-hover:border-mint/50",
    icon: "text-mint",
    glow: "group-hover:shadow-mint/20"
  },
  sky: {
    bg: "bg-sky/10",
    border: "group-hover:border-sky/50",
    icon: "text-sky",
    glow: "group-hover:shadow-sky/20"
  },
  rose: {
    bg: "bg-rose/10",
    border: "group-hover:border-rose/50",
    icon: "text-rose",
    glow: "group-hover:shadow-rose/20"
  }
};
---

<section id="features" class="py-section relative">
  <!-- Section background accent -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/2 left-0 w-[500px] h-[500px] bg-gradient-to-r from-iris/10 to-transparent rounded-full blur-3xl -translate-x-1/2"></div>
    <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-gradient-to-l from-amber/10 to-transparent rounded-full blur-3xl translate-x-1/2"></div>
  </div>

  <div class="container relative z-10">
    <!-- Section header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="reveal inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface/50 border border-elevated mb-6">
        <span class="text-sm text-iris font-medium">12 Features</span>
      </div>
      <h2 class="reveal heading-lg mb-6">
        Everything you need for<br />
        <span class="gradient-text">family focus</span>
      </h2>
      <p class="reveal body-lg text-text-secondary">
        Powerful blocking tools meet family management. Control screen time across
        all your family's devices with physical triggers and secure profiles.
      </p>
    </div>

    <!-- Features grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
      {features.map((feature, index) => {
        const colors = colorClasses[feature.color as keyof typeof colorClasses];
        return (
          <div
            class={`reveal group relative card p-6 transition-all duration-500 ${colors.border} ${colors.glow} group-hover:shadow-xl`}
            style={`transition-delay: ${index * 50}ms;`}
          >
            {feature.isNew && (
              <div class="absolute -top-2 -right-2 px-2 py-0.5 rounded-full bg-gradient-to-r from-rose to-amber text-xs font-bold text-void">
                NEW
              </div>
            )}

            <div class={`w-12 h-12 rounded-xl ${colors.bg} flex items-center justify-center mb-4`}>
              <div class={`w-6 h-6 ${colors.icon}`} set:html={feature.icon} />
            </div>

            <h3 class="heading-sm mb-2">{feature.title}</h3>
            <p class="text-text-secondary text-sm leading-relaxed">{feature.description}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>
