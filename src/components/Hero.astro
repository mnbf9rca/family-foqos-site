---
// Hero section with app branding and device mockup
---

<section class="relative min-h-screen flex items-center justify-center pt-20 pb-32 overflow-hidden">
  <!-- Decorative elements -->
  <div class="absolute inset-0 pointer-events-none">
    <!-- Floating orbs -->
    <div class="absolute top-20 left-10 w-4 h-4 bg-iris rounded-full animate-float opacity-60"></div>
    <div class="absolute top-40 right-20 w-3 h-3 bg-amber rounded-full animate-float opacity-50" style="animation-delay: 1s;"></div>
    <div class="absolute bottom-40 left-1/4 w-2 h-2 bg-rose rounded-full animate-float opacity-40" style="animation-delay: 2s;"></div>
    <div class="absolute top-1/3 right-1/4 w-3 h-3 bg-mint rounded-full animate-float opacity-30" style="animation-delay: 1.5s;"></div>

    <!-- Geometric shapes -->
    <div class="absolute top-1/4 left-20 w-32 h-32 border border-iris/20 rounded-2xl rotate-12 hidden lg:block"></div>
    <div class="absolute bottom-1/4 right-20 w-24 h-24 border border-amber/20 rounded-full hidden lg:block"></div>
  </div>

  <div class="container relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <!-- Left column - Content -->
      <div class="text-center lg:text-left">
        <!-- Badge -->
        <div class="animate-fade-in-up inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface/80 border border-elevated mb-8 backdrop-blur-sm">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-mint opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-mint"></span>
          </span>
          <span class="text-sm text-text-secondary">Open Source</span>
          <span class="text-text-muted">•</span>
          <span class="text-sm text-text-secondary">Privacy-First</span>
        </div>

        <!-- App icon and name -->
        <div class="animate-fade-in-up delay-1 flex items-center gap-4 justify-center lg:justify-start mb-6">
          <div class="relative">
            <div class="w-16 h-16 md:w-20 md:h-20 rounded-2xl bg-gradient-to-br from-iris via-iris-dim to-rose p-[2px] glow-iris">
              <div class="w-full h-full rounded-2xl bg-deep flex items-center justify-center overflow-hidden">
                <img
                  src="/app-icon.png"
                  alt="Family Foqos"
                  class="w-full h-full object-cover"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                />
                <div class="hidden w-full h-full items-center justify-center text-3xl font-bold gradient-text">
                  F
                </div>
              </div>
            </div>
            <!-- Glow effect -->
            <div class="absolute inset-0 w-16 h-16 md:w-20 md:h-20 rounded-2xl bg-iris/30 blur-xl -z-10 animate-pulse-glow"></div>
          </div>
          <h1 class="heading-md gradient-text">Family Foqos</h1>
        </div>

        <!-- Headline -->
        <h2 class="animate-fade-in-up delay-2 heading-xl mb-6">
          Focus for the<br />
          <span class="gradient-text-warm">whole family</span>
        </h2>

        <!-- Subheadline -->
        <p class="animate-fade-in-up delay-3 body-lg text-text-secondary max-w-xl mx-auto lg:mx-0 mb-10">
          Bring intentional screen time to everyone. Physical NFC and QR blocking,
          parent controls, and locked profiles - because focus is a family affair.
        </p>

        <!-- CTA Buttons -->
        <div class="animate-fade-in-up delay-4 flex flex-col sm:flex-row gap-4 justify-center lg:justify-start mb-8">
          <a href="#download" class="btn-primary inline-flex items-center justify-center gap-2 group">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
            </svg>
            <span>Get the App</span>
          </a>
          <a href="https://github.com/mnbf9rca/family-foqos" target="_blank" rel="noopener noreferrer" class="btn-secondary inline-flex items-center justify-center gap-2 group">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            <span>View Source</span>
          </a>
        </div>

        <!-- Stats -->
        <div class="animate-fade-in-up delay-5 flex items-center gap-8 justify-center lg:justify-start text-sm">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-iris" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span class="text-text-secondary">Privacy-first</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <span class="text-text-secondary">Family sync</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span class="text-text-secondary">iOS native</span>
          </div>
        </div>
      </div>

      <!-- Right column - Device mockup -->
      <div class="animate-fade-in-scale delay-3 relative flex justify-center">
        <!-- Phone frame -->
        <div class="relative">
          <!-- Glow behind phone -->
          <div class="absolute inset-0 bg-gradient-to-br from-iris/40 via-rose/20 to-amber/30 rounded-[60px] blur-3xl scale-90 animate-pulse-glow"></div>

          <!-- Phone body -->
          <div class="relative w-[280px] md:w-[320px] h-[580px] md:h-[660px] bg-gradient-to-b from-elevated to-surface rounded-[50px] p-3 border border-iris-muted/30 shadow-2xl">
            <!-- Screen -->
            <div class="w-full h-full bg-abyss rounded-[42px] overflow-hidden relative">
              <img
                src="/family-controls.PNG"
                alt="Family Foqos app showing Family Controls screen"
                class="w-full h-full object-cover object-top"
              />
            </div>
          </div>

          <!-- Floating feature badges -->
          <div class="hidden lg:block absolute -left-32 top-1/4 animate-float" style="animation-delay: 0.5s;">
            <div class="bg-surface/90 backdrop-blur-sm border border-elevated rounded-xl px-4 py-2 shadow-lg">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-iris/20 flex items-center justify-center">
                  <svg class="w-4 h-4 text-iris" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4" />
                  </svg>
                </div>
                <span class="text-sm font-medium">NFC Block</span>
              </div>
            </div>
          </div>

          <div class="hidden lg:block absolute -right-36 top-1/2 animate-float" style="animation-delay: 1s;">
            <div class="bg-surface/90 backdrop-blur-sm border border-elevated rounded-xl px-4 py-2 shadow-lg">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-rose/20 flex items-center justify-center">
                  <svg class="w-4 h-4 text-rose" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                  </svg>
                </div>
                <span class="text-sm font-medium">Lock Codes</span>
              </div>
            </div>
          </div>

          <div class="hidden lg:block absolute -left-28 bottom-1/4 animate-float" style="animation-delay: 1.5s;">
            <div class="bg-surface/90 backdrop-blur-sm border border-elevated rounded-xl px-4 py-2 shadow-lg">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-amber/20 flex items-center justify-center">
                  <svg class="w-4 h-4 text-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                  </svg>
                </div>
                <span class="text-sm font-medium">Family Sync</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-fade-in-up delay-6">
    <div class="flex flex-col items-center gap-2 text-text-muted">
      <span class="text-xs uppercase tracking-widest">Discover</span>
      <div class="w-6 h-10 border-2 border-elevated rounded-full p-1">
        <div class="w-1.5 h-1.5 bg-iris rounded-full animate-bounce mx-auto"></div>
      </div>
    </div>
  </div>
</section>
