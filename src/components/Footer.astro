---
// Footer with links and donation encouragement

const currentYear = new Date().getFullYear();
---

<footer class="py-12 border-t border-elevated relative">
  <div class="container">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8">
      <!-- Logo and tagline -->
      <div class="flex flex-col items-center md:items-start gap-3">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-iris via-iris-dim to-rose p-[1px]">
            <div class="w-full h-full rounded-xl bg-deep flex items-center justify-center overflow-hidden">
              <img
                src="/app-icon.png"
                alt="Family Foqos"
                class="w-full h-full object-cover"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
              <span class="hidden text-lg font-bold gradient-text">F</span>
            </div>
          </div>
          <span class="font-semibold">Family Foqos</span>
        </div>
        <p class="text-text-muted text-sm">Focus for the whole family</p>
      </div>

      <!-- Links -->
      <div class="flex flex-wrap items-center justify-center gap-6 text-sm">
        <a
          href="https://github.com/mnbf9rca/family-foqos"
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-secondary hover:text-text transition-colors inline-flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          GitHub
        </a>
        <a href="#features" class="text-text-secondary hover:text-text transition-colors">
          Features
        </a>
        <a href="#how-it-works" class="text-text-secondary hover:text-text transition-colors">
          How It Works
        </a>
        <a href="#faq" class="text-text-secondary hover:text-text transition-colors">
          FAQ
        </a>
        <a href="/support" class="text-text-secondary hover:text-text transition-colors">
          Support
        </a>
        <a href="/privacy" class="text-text-secondary hover:text-text transition-colors">
          Privacy
        </a>
      </div>

      <!-- Donation -->
      <div class="text-center md:text-right">
        <p class="text-text-muted text-xs mb-2">Family Foqos is free. Consider supporting:</p>
        <a
          href="https://www.commonsensemedia.org/donate"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-amber hover:text-amber-bright transition-colors text-sm font-medium"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
          Donate to Common Sense Media
        </a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-10 pt-6 border-t border-elevated/50 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-text-muted">
      <p>&copy; {currentYear} Family Foqos. Open source under MIT License.</p>
      <p class="whitespace-nowrap">Built by <a href="https://blog.cynexia.com" rel="me" class="hover:text-text transition-colors">Rob Aleck</a></p>
      <div class="flex items-center gap-4">
        <span>No tracking</span>
        <span class="text-elevated">•</span>
        <span>No ads</span>
        <span class="text-elevated">•</span>
        <span>No data collection</span>
      </div>
    </div>
  </div>
</footer>
